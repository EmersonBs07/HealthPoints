<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FFF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- SAUDAÇÃO -->

        <TextView
            android:id="@+id/txtSaudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá! 👋"
            android:textColor="#65736D"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Vamos cuidar de você?"
            android:textColor="#17211D"
            android:textSize="27sp"
            android:textStyle="bold" />


        <!-- CARD DE PONTOS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#D8F7E8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="22dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="⭐"
                android:textSize="38sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seus pontos hoje"
                    android:textColor="#557066"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtPontos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pontos"
                    android:textColor="#17211D"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue cuidando da sua saúde!"
                    android:textColor="#6A7A73"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- RESUMO DE HOJE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Resumo de hoje"
            android:textColor="#17211D"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ÁGUA / SONO / METAS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">


            <!-- ÁGUA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="#E2F3FF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/txtAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="0%"
                    android:textColor="#17211D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Água"
                    android:textColor="#53635C"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- SONO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="#EEE8FF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/txtSono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="0%"
                    android:textColor="#17211D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sono"
                    android:textColor="#53635C"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- METAS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#FFF3D6"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/txtMetas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="0%"
                    android:textColor="#17211D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metas"
                    android:textColor="#53635C"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- AÇÕES RÁPIDAS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Ações rápidas"
            android:textColor="#17211D"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- BEBER ÁGUA -->

        <Button
            android:id="@+id/btnAgua"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="15dp"
            android:text="💧 Beber água     +250 ml"
            android:textAllCaps="false"
            android:textSize="16sp" />


        <!-- REGISTRAR SONO -->

        <Button
            android:id="@+id/btnSono"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="10dp"
            android:text="🌙 Registrar sono"
            android:textAllCaps="false"
            android:textSize="16sp" />


        <!-- DICA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFF3C9"
            android:padding="18dp"
            android:text="💡 Complete suas metas diárias para ganhar Health Points!"
            android:textColor="#554B28"
            android:textSize="14sp" />


        <!-- HISTÓRICO RECENTE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Histórico recente"
            android:textColor="#17211D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtHistoricoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum registro anterior"
                android:textColor="#17211D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistoricoResumo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Seus registros aparecerão aqui."
                android:textColor="#6B7772"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- MENU INFERIOR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnInicio"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="⌂&#10;Início"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMetas"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="◎&#10;Metas"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="📅&#10;Histórico"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPerfil"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="♙&#10;Perfil"
                android:textAllCaps="false"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>